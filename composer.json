{
    "name": "filagora/filagora-cms",
    "description": "Pages, blocks, navigations, media and a draft, version, schedule and preview workflow for Filagora.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "forum",
        "filagora",
        "cms"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "filagora/filagora-core": "^0.2.1"
    },
    "require-dev": {
        "filagora/filagora-entitlements": "^0.2.1",
        "filagora/filagora-search": "^0.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\Cms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\Cms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\Cms\\CmsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "filagora/filagora-entitlements": "Answers the access checks from entitlement grants and lets the menu editor pick entitlement keys. Without it, bind Filagora\\Core\\Contracts\\AccessChecker.",
        "filagora/filagora-search": "Adds page search with a choice of engine: Meilisearch, or the database."
    }
}
